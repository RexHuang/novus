# Novus — LLM connection (dual-track: NOVUS_* takes priority over ANTHROPIC_*)
# Works with any Anthropic-protocol compatible endpoint:
#   Anthropic, DeepSeek, Zhipu GLM, Moonshot, local gateways...

# ── Native (recommended) ─────────────────────────────
# NOVUS_BASE_URL=https://api.anthropic.com
# NOVUS_AUTH_TOKEN=sk-ant-...
# NOVUS_MODEL=claude-sonnet-4-20250514

# ── Claude Code compatible (auto-picked-up if NOVUS_* unset) ──
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Optional: browser-mode web fetching ──────────────
# npm install playwright && npx playwright install chromium
